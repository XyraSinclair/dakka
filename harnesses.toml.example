# harnesses — the agent CLIs dakka orchestrates. Adding one is config,
# not code: command template, how the prompt is passed, timeout.
# Copy to harnesses.toml and adjust to what `dakka doctor` finds.

default = "claude"        # harness for single/judge/loop stages
fanout = ["claude", "codex", "gemini"]   # round-robin pool for fanout stages

[harness.claude]
# Read-only permission mode: planning needs to read your repo, not write it.
# Swap in "--dangerously-skip-permissions" only if you understand what that means.
cmd = ["claude", "-p", "--permission-mode", "plan", "--output-format", "stream-json", "--verbose"]
prompt = "stdin"          # "stdin": piped (avoids argv size limits); "arg": final argument
timeout_secs = 900
# stream-json capture concatenates every assistant text block, recovering
# deliverable text the model wrote before a trailing tool call — plain
# `claude -p` silently returns only the final message.
capture = "stream-json"
min_output_bytes = 200    # reject obviously-truncated deliverables
# env = { SOME_VAR = "1" }  # optional per-harness environment. If you run Stop
# hooks that append a summary turn, disable them here — otherwise the summary
# replaces the deliverable.

[harness.codex]
cmd = ["codex", "exec", "--sandbox", "read-only", "--skip-git-repo-check", "-"]
prompt = "stdin"
timeout_secs = 900

[harness.gemini]
cmd = ["gemini", "-p"]
prompt = "arg"
timeout_secs = 900

# A free local model, an omp headless worker, anything with a CLI:
# [harness.local]
# cmd = ["omp", "-p", "--model", "openai-codex/gpt-5.6-sol", "--no-session", "--auto-approve"]
# prompt = "arg"
# timeout_secs = 1200
